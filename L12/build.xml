<?xml version="1.0" encoding="UTF-8"?>
<project name="Hack &amp; Play · L12 Open Cabinet" default="run" basedir=".">
  <property file="nbproject/private/private.properties"/>
  <property file="nbproject/project.properties"/>
  <property name="jdk.home" value="${java.home}"/>
  <property name="run.class" value="${main.class}"/>
  <property name="application.args" value=""/>
  <property name="javac.includes" value="**/*.java"/>
  <target name="compile">
    <mkdir dir="${build.classes.dir}"/>
    <javac srcdir="${src.dir}" destdir="${build.classes.dir}" release="26"
      encoding="UTF-8" debug="true" includeantruntime="false" fork="true"
      executable="${jdk.home}/bin/javac"/>
  </target>
  <target name="compile-single" depends="compile"/>
  <target name="launch">
    <java classname="${run.class}" classpath="${build.classes.dir}" fork="true"
      failonerror="true" dir="${basedir}" jvm="${jdk.home}/bin/java">
      <jvmarg value="-Dfile.encoding=UTF-8"/><jvmarg value="-ea"/>
      <arg line="${application.args}"/>
    </java>
  </target>
  <target name="run" depends="compile,launch"/>
  <target name="run-single" depends="compile-single,launch"/>
  <target name="compile-test" depends="compile">
    <mkdir dir="${build.test.classes.dir}"/>
    <javac srcdir="${test.src.dir}" destdir="${build.test.classes.dir}" release="26"
      classpath="${build.classes.dir}" encoding="UTF-8" includeantruntime="false"
      fork="true" executable="${jdk.home}/bin/javac"/>
  </target>
  <target name="test" depends="compile-test">
    <java classname="CourseChecks" fork="true" failonerror="true"
      dir="${basedir}" jvm="${jdk.home}/bin/java">
      <classpath><pathelement path="${build.classes.dir}"/><pathelement path="${build.test.classes.dir}"/></classpath>
      <sysproperty key="java.awt.headless" value="true"/>
      <jvmarg value="-Dfile.encoding=UTF-8"/><jvmarg value="-ea"/>
    </java>
  </target>
  <target name="test-single" depends="compile-test">
    <fail unless="test.class" message="Choose Test File on a source or on its matching Test file, or pass -Dtest.class=NameTest."/>
    <java classname="${test.class}" fork="true" failonerror="true" dir="${basedir}" jvm="${jdk.home}/bin/java">
      <classpath><pathelement path="${build.classes.dir}"/><pathelement path="${build.test.classes.dir}"/></classpath>
      <sysproperty key="java.awt.headless" value="true"/>
      <jvmarg value="-Dfile.encoding=UTF-8"/><jvmarg value="-ea"/>
    </java>
  </target>
  <target name="debug" depends="compile">
    <fail unless="netbeans.home" message="Use Debug File in NetBeans."/>
    <nbjpdastart addressproperty="jpda.address" name="${application.title}" transport="dt_socket">
      <classpath path="${build.classes.dir}"/><sourcepath path="${src.dir}"/>
    </nbjpdastart>
    <java classname="${run.class}" classpath="${build.classes.dir}" fork="true"
      failonerror="true" dir="${basedir}" jvm="${jdk.home}/bin/java">
      <jvmarg value="-agentlib:jdwp=transport=dt_socket,address=${jpda.address},server=n,suspend=y"/>
      <jvmarg value="-Dfile.encoding=UTF-8"/><jvmarg value="-ea"/><arg line="${application.args}"/>
    </java>
  </target>
  <target name="debug-single" depends="debug"/>
  <target name="jar" depends="compile">
    <mkdir dir="${dist.dir}"/>
    <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
      <manifest><attribute name="Main-Class" value="${main.class}"/></manifest>
    </jar>
  </target>
  <target name="clean"><delete dir="${build.dir}"/><delete dir="${dist.dir}"/></target>
  <target name="rebuild" depends="clean,jar"/>
</project>
